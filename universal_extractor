import pdfplumber
import json
import os
import re

def extract_ppl_with_images(pdf_filename, output_name):
    current_dir = os.path.dirname(os.path.abspath(__file__))
    pdf_path = os.path.join(current_dir, pdf_filename)
    
    if not os.path.exists(pdf_path):
        print(f"CHYBA: Soubor {pdf_filename} nebyl nalezen!")
        return

    questions_db = []
    current_q = None
    problematic_ids = []

    # Regex pro hledání kódu obrázku (např. ALW-020) v závorkách
    image_pattern = r'\(?([A-Z]{2,3}-\d{3})\)?'

    print(f"--- Zahajuji extrakci s detekcí obrázků: {pdf_filename} ---")

    with pdfplumber.open(pdf_path) as pdf:
        for page in pdf.pages:
            lines = page.extract_text_lines()
            
            for line in lines:
                text = line['text'].strip()
                if not text or "Verze" in text or "Strana" in text:
                    continue

                is_bold = any("Bold" in char.get("fontname", "") for char in line["chars"])
                q_start_match = re.match(r'^(\d+)\s+(.+)', text)
                
                if is_bold and q_start_match:
                    if current_q:
                        if len(current_q["answers"]) > 4:
                            problematic_ids.append(current_q["id"])
                        questions_db.append(current_q)
                    
                    question_id = int(q_start_match.group(1))
                    question_body = q_start_match.group(2).strip()
                    
                    current_q = {
                        "id": question_id,
                        "question": question_body,
                        "answers": [],
                        "correct": None,
                        "image": None # Defaultně žádný obrázek
                    }
                
                elif is_bold and current_q and not current_q["answers"]:
                    current_q["question"] += " " + text
                
                elif not is_bold and current_q:
                    clean_ans = re.sub(r'^[a-g]\)\s*', '', text)
                    if clean_ans:
                        current_q["answers"].append(clean_ans)

        # PO-ZPRACOVÁNÍ: Hledání obrázků v textu otázky
        for q in questions_db:
            # Hledáme shodu s patternem ALW-000
            match = re.search(image_pattern, q["question"])
            if match:
                img_code = match.group(1) # Získáme ALW-020
                q["image"] = f"{img_code}.png" # Předpokládáme příponu .png
                
                # Volitelné: Odstranění "Viz obr. (ALW-020)" z textu, aby to tam nepřekáželo
                q["question"] = re.sub(r'Viz obr\.\s*\(?' + img_code + r'\)?', '', q["question"]).strip()
                q["question"] = re.sub(r'\(' + img_code + r'\)', '', q["question"]).strip()

        if current_q:
            questions_db.append(current_q)

    # Uložení do JSONu
    final_data = [q for q in questions_db if len(q["answers"]) > 0]
    
    # Ujistíme se, že složka Klice existuje
    if not os.path.exists('Klice'):
        os.makedirs('Klice')
        
    output_path = os.path.join('Klice', output_name)
    with open(output_path, "w", encoding="utf-8") as f:
        json.dump(final_data, f, indent=2, ensure_ascii=False)

    print(f"--- HOTOVO ---")
    print(f"Celkem: {len(final_data)} otázek uloženo do Klice/{output_name}")
    
    img_count = len([q for q in final_data if q["image"]])
    print(f"Nalezeno otázek s obrázkem: {img_count}")

if __name__ == "__main__":
    # Změň název podle toho, co zrovna zpracováváš
    extract_ppl_with_images("Lidska_vykonnost_pred.pdf", "Lidska_vykonnost.json")